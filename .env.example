# Pharos Network RPC
PHAROS_RPC_URL=https://rpc.pharos.network

# Feature Flags
ENABLE_WALLET_CONNECT=true
ENABLE_NFT_CHECKER=true
ENABLE_REPUTATION_CHECKER=true
ENABLE_WALLET_ASSISTANT=true
ENABLE_TRANSACTION_EXPLAINER=true
ENABLE_REALFI_MONITOR=true

# Security
LOG_LEVEL=info
ENABLE_SIGNATURE_VERIFICATION=true
